{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "FREELLMAPI_API_KEY_PLACEHOLDER",
    "ANTHROPIC_BASE_URL": "http://localhost:3001/v1",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "auto",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "auto",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "auto",
    "ANTHROPIC_MODEL": "auto",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1048576",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node FREELLMAPI_MEM_HOME_PLACEHOLDER/session-start.js",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node FREELLMAPI_MEM_HOME_PLACEHOLDER/session-end.js",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "autoCompactEnabled": true,
  "mcpServers": {
    "shared-memory": {
      "command": "FREELLMAPI_NODE_BIN_PLACEHOLDER",
      "args": ["FREELLMAPI_MEM_HOME_PLACEHOLDER/server.js"],
      "env": { "MEM_DB_PATH": "FREELLMAPI_MEM_HOME_PLACEHOLDER/db/mem.db" }
    }
  }
}